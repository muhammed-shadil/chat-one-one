rules_version = '2';

// There are no accounts, so access is controlled by the chat ID instead:
// only data under this one ID (kChatId in lib/config.dart) can be touched.
// Everything else, including listing which chats exist, is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /chats/rhxd7yqwcq6xant5r6k5nzvx {

      match /messages/{messageId} {
        allow read, delete: if true;

        allow create: if request.resource.data.senderId in ['p1', 'p2']
                      && request.resource.data.type in ['text', 'image', 'file', 'audio'];

        // After sending, only read receipts, view-once and voice-played state,
        // reactions, and the words of a text message (an edit) may change.
        allow update: if changed().hasOnly(['seen', 'opened', 'openedAt', 'url', 'played',
                                            'reactions', 'text', 'edited', 'editedAt'])
                      && (!changed().hasAny(['text', 'edited', 'editedAt'])
                          || resource.data.type == 'text')
                      && (!('reactions' in request.resource.data)
                          || request.resource.data.reactions.keys().hasOnly(['p1', 'p2']));

        function changed() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }
      }

      match /members/{personId} {
        allow read: if true;
        allow write: if personId in ['p1', 'p2'];
      }

      // A location someone chose to share one time (no tracking), one per
      // person: sharing again replaces it, so there are never duplicates.
      // It can't be listed, only fetched by person, and once it expires
      // (kLocationRetention in lib/config.dart, 30 days at most) it can't be
      // read at all, only deleted. Deleting removes it for good: unlike
      // messages, nothing is archived.
      match /locations/{personId} {
        allow get: if personId in ['p1', 'p2']
                   && (resource == null || resource.data.expiresAt > request.time);
        allow create, update: if personId in ['p1', 'p2'] && isValidLocation();
        allow delete: if personId in ['p1', 'p2'];

        function isValidLocation() {
          let d = request.resource.data;
          let fields = ['userId', 'latitude', 'longitude', 'accuracy',
                        'capturedAt', 'sharedAt', 'expiresAt', 'sharingType'];
          return d.keys().hasAll(fields) && d.keys().hasOnly(fields)
              && d.userId == personId
              && d.sharingType == 'one_time'
              && d.latitude is number && d.latitude >= -90 && d.latitude <= 90
              && d.longitude is number && d.longitude >= -180 && d.longitude <= 180
              // Meters; same limit as LocationFix.maxAccuracy.
              && d.accuracy is number && d.accuracy >= 0 && d.accuracy <= 100000
              && d.capturedAt is timestamp
              && d.capturedAt < request.time + duration.value(1, 'h')
              && d.sharedAt == request.time
              && d.expiresAt is timestamp
              && d.expiresAt > request.time
              && d.expiresAt <= request.time + duration.value(30, 'd');
        }
      }

      // Archive of opened view-once photos and deleted messages. Written by
      // Cloud Functions only; visible only in the Firebase console.
      match /deleted/{messageId} {
        allow read, write: if false;
      }
    }
  }
}
